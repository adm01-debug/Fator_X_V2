# Playwright test artifacts (generated at runtime, not source)
test-results/
playwright-report/
tsconfig.app.tsbuildinfo
tsconfig.node.tsbuildinfo

# Grafo de codigo (graphify): gerado por clone, ~100 MB — ver scripts/graphify/setup.sh
graphify-out/

# Estado local privado dos novos adaptadores de automação
/.tools/repo-automation/
/.tools/graphify/local-state/

# Deno lockfile local (edge functions usam imports de URL pinada; sem lock no repo)
deno.lock

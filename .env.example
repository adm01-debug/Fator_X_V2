# ═══════════════════════════════════════════════════════════
# Nexus Agents Studio — Environment Variables Template
# COPIE ESTE ARQUIVO PARA .env.local E PREENCHA OS VALORES
# NUNCA COMMIT este arquivo com valores reais
# ═══════════════════════════════════════════════════════════

# ── Supabase (projeto principal — auth + dados) ─────────────
# Banco único: qdlnzopxrlsoljcrcmzv cobre auth E dados
# OBTER EM: https://supabase.com/dashboard/project/qdlnzopxrlsoljcrcmzv/settings/api
VITE_SUPABASE_URL=https://qdlnzopxrlsoljcrcmzv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME
VITE_SUPABASE_PROJECT_ID=qdlnzopxrlsoljcrcmzv

# ── Supabase (Datahub — espelhado para o mesmo projeto) ───────
# Mantemos as variáveis externas apontando para o mesmo banco
# enquanto a migração do Lovable está em andamento. Quando os
# projetos externos do Datahub voltarem, é só trocar esses dois
# valores.
VITE_EXTERNAL_SUPABASE_URL=https://qdlnzopxrlsoljcrcmzv.supabase.co
VITE_EXTERNAL_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# ── API Keys Externas ──────────────────────────────────────────
# NUNCA COMMIT valores reais — use GitHub Secrets ou .env.local
OPENAI_API_KEY=sk-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
HUGGINGFACE_API_KEY=hf_REPLACE_ME
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
OPENROUTER_MODEL_PRO=deepseek/deepseek-reasoner
HERMES_API_KEY=REPLACE_ME
HERMES_BASE_URL=https://api.hermes.ai/v1
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_SIGNING_SECRET=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
WHATSAPP_ZAPI_TOKEN=REPLACE_ME
WHATSAPP_EVOLUTION_TOKEN=REPLACE_ME

# ── Sentry (Observabilidade) ───────────────────────────────────
VITE_SENTRY_DSN=https://REPLACE_ME@sentry.io/REPLACE_ME

# ── Langfuse (Tracing) ─────────────────────────────────────────
VITE_LANGFUSE_PUBLIC_KEY=pk_REPLACE_ME
VITE_LANGFUSE_SECRET_KEY=sk_REPLACE_ME
VITE_LANGFUSE_HOST=https://REPLACE_ME.langfuse.com

# ── Otel (OpenTelemetry) ──────────────────────────────────────
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=https://REPLACE_ME
VITE_OTEL_SERVICE_NAME=nexus-agents-studio

# ── Application ────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development
